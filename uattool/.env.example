# Copy this file to uattool/.env and fill in the real values.
# uattool/.env is gitignored and must never be committed.

# Required: admin password for kdresdell@gmail.com on kdc.minipass.me.
UAT_ADMIN_PASSWORD=

# Optional: required for row 05 to post to the real Discord channel.
# Without it, row 05 still sends and tests the email announcement.
UAT_DISCORD_WEBHOOK_URL=

# Optional: lets branding rows 13a-13h prove that signup/passport emails arrived
# and capture the received HTML at desktop/mobile sizes. For Gmail, use an app
# password, not the account password. If omitted, the report creates an explicit
# manual inbox-check reminder and never claims receipt was verified.
UAT_IMAP_HOST=imap.gmail.com
UAT_IMAP_PORT=993
UAT_IMAP_USERNAME=kdresdell@gmail.com
UAT_IMAP_PASSWORD=
UAT_IMAP_FOLDER=INBOX
UAT_IMAP_WAIT_SECONDS=90
